{
    "name": "sheadawson/silverstripe-blocks",
    "description": "An alternative to the SilverStripe Widgets module.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "blocks",
        "widgets"
    ],
    "homepage": "http://github.com/sheadawson/silverstripe-blocks",
    "authors": [
        {
            "name": "Pramesh Harshana",
            "email": "prameshharshana@gmail.com"
        }
    ],
    "require": {
        "composer/installers": "*",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.0",
        "symbiote/silverstripe-multivaluefield": "^7.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-name": "blocks",
        "expose": [
            "css",
            "images",
            "javascript"
        ]
    },
    "autoload": {
    	"psr-4": {
    		"SheaDawson\\Blocks\\": "src/"
    	}
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
